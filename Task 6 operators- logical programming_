#Arithmetic operators example 3, with numbers
Apples_eaten = 5
Apples_left = 10
print("Apples eaten:", Apples_eaten)
print("Apples left:", Apples_left)
print("Total apples:", Apples_eaten + Apples_left)
print("Difference:", Apples_left - Apples_eaten)
print("Product:", Apples_eaten * Apples_left)
print("Quotient:", Apples_left / Apples_eaten)
#end of the arithmetic operators example

